generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  MANAGER
  EMPLOYEE
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  COUNSELLING
  ADMITTED
  LOST
}

enum AdmissionStatus {
  PENDING
  ONGOING
  COMPLETED
  CANCELLED
}

enum WalkInStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum CounsellingStatus {
  SCHEDULED
  FOLLOW_UP
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncentiveStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum LeadDatasetType {
  EXTERNAL_DATA
  OFFLINE_LEADGEN
  PURCHASED
  UPLOADED
  ASSIGNED
}

enum CustomFieldEntityType {
  LEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  DROPDOWN
  DATE
  CHECKBOX
  EMAIL
  PHONE
}

enum IntegrationProvider {
  WEBSITE_API
  GOOGLE_FORMS
  META_LEADS
  WHATSAPP
  EMAIL_SMTP
  GENERIC_WEBHOOK
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum SupportTicketType {
  TECHNICAL_ISSUE
  FEATURE_REQUEST
  CUSTOMIZATION
  INTEGRATION
  BILLING
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  DEVELOPMENT
  COMPLETED
  REJECTED
  CLOSED
}

enum CalendarEventType {
  MEETING
  FOLLOW_UP
  COUNSELLING
  ADMISSION
  PAYMENT
  REMINDER
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Company {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  brandName    String?
  shortName    String?
  business     String?
  ownerName    String?
  city         String?
  email        String?
  phone        String?
  logoUrl      String?
  primaryColor String?
  subdomain    String? @unique

  status CompanyStatus @default(TRIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  subscriptions  Subscription[]
  companyModules CompanyModule[]
  settings       CompanySettings?

  leads                   Lead[]
  utmLinks                UtmLink[]
  admissions              Admission[]
  expenses                Expense[]
  incentives              Incentive[]
  leadDatasets            LeadDataset[]
  supportTickets          SupportTicket[]
  notifications           Notification[]
  payments                PaymentTransaction[]
  leadSources             LeadSourceConfig[]
  customFields            CustomField[]
  integrations            CompanyIntegration[]
  notificationPreferences UserNotificationPreference[]
  auditLogs               AuditLog[]
  walkIns                 WalkIn[]
  counsellingSessions     CounsellingSession[]
  admissionPartners       AdmissionPartner[]
  admissionStreams        AdmissionStream[]
  calendarEvents          CalendarEvent[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)

  active Boolean @default(true)

  phone      String?
  jobTitle   String?
  department String?

  canManageUsers      Boolean @default(false)
  canManageSettings   Boolean @default(false)
  canManageBilling    Boolean @default(false)
  canViewAnalytics    Boolean @default(false)
  canManageAdmissions Boolean @default(false)
  canManageRevenue    Boolean @default(false)
  canManageLeads      Boolean @default(false)
  canManageSupport    Boolean @default(false)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incentives             Incentive[]
  notifications          Notification[]
  payments               PaymentTransaction[]
  notificationPreference UserNotificationPreference?
  auditLogs              AuditLog[]
  assignedLeadDatasets   LeadDataset[]               @relation("LeadDatasetAssignee")
  calendarEventsCreated  CalendarEvent[]             @relation("CalendarEventCreator")
  calendarEventsAssigned CalendarEvent[]             @relation("CalendarEventAssignee")

  @@index([companyId])
  @@index([companyId, role])
  @@index([companyId, active])
}

model Plan {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  tagline     String?

  monthlyPrice Decimal  @db.Decimal(12, 2)
  yearlyPrice  Decimal? @db.Decimal(12, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  planModules   PlanModule[]
  payments      PaymentTransaction[]
}

model Module {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  icon        String?
  route       String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModules    PlanModule[]
  companyModules CompanyModule[]
}

model PlanModule {
  id String @id @default(cuid())

  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
}

model CompanyModule {
  id String @id @default(cuid())

  companyId String
  moduleId  String

  enabled Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
}

model Subscription {
  id String @id @default(cuid())

  companyId String
  planId    String

  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)

  startDate   DateTime  @default(now())
  renewalDate DateTime?
  endDate     DateTime?

  amount Decimal? @db.Decimal(12, 2)

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan                 @relation(fields: [planId], references: [id])
  payments PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([planId])
}

model PaymentTransaction {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  initiatedByUserId String?
  initiatedByUser   User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(CREATED)

  billingCycle BillingCycle

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  providerOrderId   String  @unique
  providerPaymentId String? @unique

  receipt String?

  failureCode   String?
  failureReason String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([subscriptionId])
  @@index([planId])
  @@index([initiatedByUserId])
}

model CompanySettings {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  portalName     String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  timezone       String  @default("Asia/Kolkata")
  currency       String  @default("INR")
  dateFormat     String  @default("DD/MM/YYYY")

  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UtmLink {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaign String
  source   String
  medium   String
  url      String

  clicks        Int @default(0)
  registrations Int @default(0)
  conversions   Int @default(0)
  admissions    Int @default(0)

  revenue Decimal @default(0) @db.Decimal(14, 2)

  active Boolean @default(true)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, campaign])
}

model LeadSourceConfig {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  key  String
  name String

  description String?

  active      Boolean @default(true)
  showInForms Boolean @default(true)
  system      Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
}

model Lead {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  course String?

  source String
  stage  LeadStage @default(NEW)

  campaign String?
  medium   String?

  assignedToName String?

  utmLinkId String?
  utmLink   UtmLink? @relation(fields: [utmLinkId], references: [id], onDelete: SetNull)

  notes String?

  admission         Admission?
  customFieldValues CustomFieldValue[]

  leadDatasetId String?
  leadDataset   LeadDataset? @relation(fields: [leadDatasetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, stage])
  @@index([companyId, createdAt])
  @@index([utmLinkId])
  @@index([leadDatasetId])
  @@index([companyId, leadDatasetId])
}

model Admission {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Stores the lead stage that existed before this admission was created.
  // This lets cancellation/deletion restore the CRM lead correctly.
  leadStageBeforeAdmission LeadStage?

  studentName  String
  studentPhone String?
  studentEmail String?

  partnerId String?
  partner   AdmissionPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  college String
  course  String

  counsellorName String?

  totalFee   Decimal @default(0) @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  status AdmissionStatus @default(ONGOING)

  admissionDate DateTime @default(now())

  notes String?

  incentives Incentive[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, admissionDate])
  @@index([partnerId])
  @@index([companyId, partnerId])
}

model AdmissionStream {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  slug String

  description String?
  color       String  @default("blue")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  partners AdmissionPartner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
}

model AdmissionPartner {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  streamId String?
  stream   AdmissionStream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  name String
  slug String

  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
  @@index([streamId])
  @@index([companyId, streamId])
}

model WalkIn {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visitorName String
  phone       String
  email       String?
  course      String?

  purpose        String
  accompaniedBy  String?
  counsellorName String?
  outcome        String?

  status WalkInStatus @default(NEW)

  arrivedAt DateTime @default(now())

  convertedLeadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, arrivedAt])
  @@index([companyId, phone])
  @@index([convertedLeadId])
}

model CounsellingSession {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leadId String?

  studentName  String
  studentPhone String?
  studentEmail String?

  course         String?
  counsellorName String?
  mode           String  @default("IN_PERSON")
  meetingLink    String?
  accompaniedBy  String?

  scheduledAt DateTime

  status CounsellingStatus @default(SCHEDULED)

  remarks    String?
  followUpAt DateTime?

  converted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([companyId, leadId])
  @@index([companyId, counsellorName])
}

model Expense {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  category    String
  description String?

  amount Decimal @db.Decimal(14, 2)

  expenseDate DateTime @default(now())

  submittedByName String?
  approvedByName  String?

  paymentMode    String?
  transactionRef String?
  vendorName     String?
  invoiceNumber  String?
  receiptUrl     String?

  status ExpenseStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
}

model Incentive {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  admissionId String?
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  employeeName String

  title       String?
  description String?

  amount Decimal @db.Decimal(14, 2)

  incentiveDate DateTime @default(now())

  status IncentiveStatus @default(PENDING)

  approvedByName String?
  paidDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, incentiveDate])
  @@index([userId])
  @@index([admissionId])
}

model LeadDataset {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  type LeadDatasetType

  sourceName String?

  sourceFileName String?

  leadCount      Int @default(0)
  importedCount  Int @default(0)
  duplicateCount Int @default(0)
  failedCount    Int @default(0)
  convertedCount Int @default(0)

  assignedToUserId String?
  assignedToUser   User?   @relation("LeadDatasetAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  notes String?

  uploadedAt DateTime @default(now())

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, uploadedAt])
  @@index([assignedToUserId])
}

model SupportTicket {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ticketNumber String @unique

  title       String
  description String

  type SupportTicketType

  priority SupportTicketPriority @default(MEDIUM)

  status SupportTicketStatus @default(NEW)

  submittedByName  String?
  submittedByEmail String?

  adminRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedAt DateTime?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([createdAt])
}

model UserNotificationPreference {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean?
  smsEnabled   Boolean?

  leadUpdates      Boolean @default(true)
  admissionUpdates Boolean @default(true)
  billingUpdates   Boolean @default(true)
  supportUpdates   Boolean @default(true)
  systemUpdates    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, userId])
}

model Notification {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String @default("INFO")

  actionModule String?
  actionLabel  String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, read])
  @@index([userId, read])
}

model CustomField {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType CustomFieldEntityType @default(LEAD)
  fieldType  CustomFieldType

  name String
  key  String

  description String?

  required    Boolean @default(false)
  showInForms Boolean @default(true)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  options Json?

  values CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType, active])
  @@index([companyId, entityType, sortOrder])
}

model CustomFieldValue {
  id String @id @default(cuid())

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customFieldId, leadId])
  @@index([leadId])
  @@index([customFieldId])
}

model CompanyIntegration {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider IntegrationProvider

  enabled Boolean           @default(false)
  status  IntegrationStatus @default(NOT_CONFIGURED)

  displayName String?
  config      Json?

  credentialsConfigured Boolean @default(false)

  lastConnectedAt DateTime?
  lastError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
  @@index([companyId, enabled])
  @@index([companyId, status])
}

model AuditLog {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  actorName  String?
  actorEmail String?
  actorRole  String?

  action     String
  entityType String
  entityId   String?

  summary String

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@index([companyId, entityType])
  @@index([actorUserId, createdAt])
}

model SuperAdminAuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actorName   String?
  actorEmail  String?

  action     String
  entityType String
  entityId   String?

  companyId   String?
  companyName String?

  summary  String
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([action])
  @@index([entityType])
}

model SystemSettings {
  id String @id @default(cuid())

  key String @unique @default("global")

  platformName String  @default("ConsulBuzz")
  supportEmail String?
  supportPhone String?

  defaultTimezone   String @default("Asia/Kolkata")
  defaultCurrency   String @default("INR")
  defaultDateFormat String @default("DD/MM/YYYY")

  defaultTrialDays Int @default(14)

  defaultBillingCycle BillingCycle @default(MONTHLY)

  defaultEmailNotifications Boolean @default(true)
  defaultSmsNotifications   Boolean @default(false)

  maintenanceMode Boolean @default(false)

  allowNewClientOnboarding Boolean @default(true)

  defaultPrimaryColor String @default("indigo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String?

  type   CalendarEventType   @default(MEETING)
  status CalendarEventStatus @default(SCHEDULED)

  startAt DateTime
  endAt   DateTime?

  allDay Boolean @default(false)

  location String?

  createdByUserId String?
  createdByUser   User?   @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedToUser   User?   @relation("CalendarEventAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startAt])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([assignedToUserId, startAt])
  @@index([createdByUserId])
}
